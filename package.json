{
  "name": "arturobarrios-web",
  "version": "1.0.0",
  "description": "Full-Stack Developer & Digital Product Creator - Personal Website",
  "author": "Arturo Barrios",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "analyze": "ANALYZE=true npm run build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "pa11y-ci",
    "test:lighthouse": "lighthouse --chrome-flags=\"--headless=new\" http://localhost:3000 --output-path=lighthouse-report.html",
    "test:all": "npm run lint && npm run test:coverage && npm run test:e2e"
  },
  "dependencies": {
    "@next/bundle-analyzer": "^16.2.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.4",
    "clsx": "^2.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "framer-motion": "^12.42.2",
    "next": "^16.2.11",
    "next-font": "^2.0.2",
    "postcss": "^8.5.21",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.82.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/react": "^4.10.1",
    "@playwright/test": "^1.48.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^3.0.5",
    "@vitest/ui": "^3.0.5",
    "jsdom": "^24.1.2",
    "lighthouse": "^12.4.1",
    "pa11y-ci": "^3.0.0",
    "playwright": "^1.48.2",
    "prettier": "^3.9.6",
    "vitest": "^3.0.5"
  }
}
