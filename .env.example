# Environment Variables Template
# Copy this file to .env.local and update with your values
# Never commit .env.local to git - it's for local development only

# ============================================================================
# SITE CONFIGURATION
# ============================================================================

# Base URL for the website
NEXT_PUBLIC_SITE_URL=https://arturobarrios.com

# Site name and description (used in metadata)
NEXT_PUBLIC_SITE_NAME=Arturo Barrios
NEXT_PUBLIC_SITE_DESCRIPTION=Full-Stack Developer & Digital Product Creator

# ============================================================================
# ANALYTICS
# ============================================================================

# Google Analytics 4 Measurement ID
# Get from: https://analytics.google.com/
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# (Optional) Vercel Analytics
# Already included via Vercel dashboard - no config needed

# ============================================================================
# CONTACT FORM
# ============================================================================

# Contact form email destination
NEXT_PUBLIC_CONTACT_EMAIL=contact@arturobarrios.com

# (Optional) Email Service Providers
# Choose one of the following:

# SendGrid API Key
# Get from: https://app.sendgrid.com/settings/api_keys
# SENDGRID_API_KEY=

# Resend API Key
# Get from: https://resend.com/api-keys
# RESEND_API_KEY=

# Mailgun API Key
# Get from: https://app.mailgun.com/app/account/security/api_keys
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=

# ============================================================================
# SOCIAL LINKS
# ============================================================================

# Social media profiles (for footer/about links)
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/arturobarrios
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/in/arturobarrios
NEXT_PUBLIC_GITHUB_URL=https://github.com/arturobarrios

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/disable features without code changes
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_CONTACT_FORM=true
NEXT_PUBLIC_ENABLE_BLOG=false

# ============================================================================
# OPTIONAL: API INTEGRATIONS
# ============================================================================

# Calendar Integration (for scheduling)
# NEXT_PUBLIC_CALENDLY_URL=

# CRM Integration
# CRM_API_KEY=
# CRM_API_URL=

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================

# Debug mode (only used in development)
# DEBUG=arturobarrios:*

# Next.js specific
# NEXT_PUBLIC_DEBUG_MODE=false

# ============================================================================
# NOTES
# ============================================================================

# IMPORTANT:
# 1. Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
#    - Do NOT put secrets in these variables
#    - They are visible in browser console/DevTools
#
# 2. Variables without NEXT_PUBLIC_ are server-only
#    - Safe for API keys and secrets
#    - Only available on the server
#
# 3. Local development:
#    - Copy this file to .env.local
#    - Update with your values
#    - Never commit .env.local to git
#
# 4. Production (Vercel):
#    - Set variables in Vercel Dashboard
#    - Dashboard: Project Settings → Environment Variables
#    - Select which environments: Production, Preview, Development
#
# 5. Do NOT include:
#    - Passwords or authentication tokens
#    - Private API keys (unless server-only, no NEXT_PUBLIC_)
#    - Personal information
#    - Database credentials
